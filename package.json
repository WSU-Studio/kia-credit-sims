{
  "name": "kia-credit-sims",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3071 --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start -p ${PORT:-8080}",
    "lint": "eslint",
    "postinstall": "node scripts/setup-prisma.js",
    "db:seed": "node prisma/seed.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate && npm run postinstall",
    "db:studio": "prisma studio",
    "test:simulate": "tsx --env-file=.env scripts/test-hyundai-simulate.ts",
    "migrate:s3-proxy": "tsx --env-file=.env scripts/migrate-s3-urls-to-proxy.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@embedpdf/react-pdf-viewer": "^2.15.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "@tabler/icons-react": "^3.34.0",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "bcryptjs": "^3.0.3",
    "isomorphic-dompurify": "^2.35.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.26.5",
    "nodemailer": "^9.0.3",
    "pg": "^8.17.1",
    "prisma": "6.19.2",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.68.0",
    "sharp": "^0.35.3",
    "undici": "^7.28.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.2.1"
