// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Authentication & Authorization
// ============================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  name                String
  isActive            Boolean   @default(true)
  /// HCFI_ADMIN | DEALER_ADMIN | SALESMAN — derived from assigned roles
  userType            String?
  /// Hyundai vendor/dealer assignment (required for DEALER_ADMIN & SALESMAN)
  vendorCode          String?
  vendorName          String?
  vendorCity          String?
  oriOfficeCode       String?
  oriOfficeName       String?
  /// Emp number CMO (HCFI) — jika terisi, CMO di leads terkunci ke nomor ini
  cmoEmpNo            String?
  /// Emp number salesman dealer (Hyundai Get List Sales Person, mis. H104299)
  salesEmpNo          String?
  // Account lockout / login hardening
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastFailedLoginAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userRoles          UserRole[]
  articles           Article[]
  dealerPromotions   DealerPromotion[]
  salesLeads         Lead[]              @relation("SalesLeads")
  preSimulations     PreSimulation[]     @relation("PreSimulationCreator")
  loginOtpChallenges LoginOtpChallenge[]

  @@index([userType])
  @@index([vendorCode])
  @@map("users")
}

/// Pending email OTP after a valid dealer/salesman password check.
/// Consumed once by NextAuth credentials; unused rows expire and are replaced on resend.
model LoginOtpChallenge {
  id           String    @id @default(uuid())
  userId       String
  email        String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  rememberMe   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("login_otp_challenges")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Additional fine-grained activities (string identifiers)
  activities String[] @default([])

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Menu {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  path      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions Permission[]

  @@map("menus")
}

model Permission {
  id        String   @id @default(uuid())
  menuCode  String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu            Menu             @relation(fields: [menuCode], references: [code], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([menuCode])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// Content Management
// ============================================

model Banner {
  id            String    @id @default(uuid())
  title         String
  titleEn       String?
  highlight     String?
  highlightEn   String?
  description   String?
  descriptionEn String?
  imageUrl      String
  ctaLabel      String?
  ctaLabelEn    String?
  ctaUrl        String?
  isActive      Boolean   @default(true)
  order         Int       @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("banners")
}

model Benefit {
  id            String   @id @default(uuid())
  title         String
  titleEn       String?
  description   String
  descriptionEn String?
  isClickable   Boolean  @default(false)
  linkUrl       String?
  openInNewTab  Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("benefits")
}

model Product {
  id         String   @id @default(uuid())
  title      String
  titleEn    String?
  subtitle   String?
  subtitleEn String?
  imageUrl   String
  content    String?  @db.Text
  contentEn  String?  @db.Text
  layout     Json?
  order      Int      @default(0)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("products")
}

model Promo {
  id                 String    @id @default(uuid())
  title              String
  titleEn            String?
  slug               String?   @unique
  description        String?
  descriptionEn      String?
  imageUrl           String?
  bannerImageRatio   String? // default | 1:1 | 4:3 | 16:9 | 3:1 | 4:1 | 5:1
  bannerUseContainer Boolean   @default(true) // false = image to edge
  showBannerImage    Boolean   @default(true) // false = hide cover image on detail page
  content            String?   @db.Text
  contentEn          String?   @db.Text
  layout             Json?
  isActive           Boolean   @default(true)
  isHighlight        Boolean   @default(false)
  order              Int       @default(0)
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("promos")
}

model Article {
  id                 String    @id @default(uuid())
  title              String
  titleEn            String?
  slug               String    @unique
  subtitle           String?
  subtitleEn         String?
  excerpt            String?
  excerptEn          String?
  content            String    @db.Text
  contentEn          String?   @db.Text
  layout             Json? // widget-based layout (same as StaticPage/Promo)
  imageUrl           String?
  bannerImageRatio   String? // default | 1:1 | 4:3 | 16:9 | 3:1 | 4:1 | 5:1
  bannerUseContainer Boolean   @default(true) // false = image to edge
  showBannerImage    Boolean   @default(true) // false = sembunyikan banner di halaman artikel
  metaDescription    String?
  metaDescriptionEn  String?
  category           String?
  tags               String[]  @default([])
  readingTime        Int? // minutes
  featured           Boolean   @default(false)
  authorId           String?
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("articles")
}

model StaticPage {
  id               String   @id @default(uuid())
  title            String
  titleEn          String?
  slug             String   @unique
  content          String?  @db.Text
  contentEn        String?  @db.Text
  layout           Json?
  showInMenu       Boolean  @default(false)
  menuOrder        Int      @default(0)
  showBasicContent Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("static_pages")
}

model FooterSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("footer_settings")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model Announcement {
  id        String    @id @default(uuid())
  message   String
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("announcements")
}

/// Tamper-evident log of sensitive admin actions. Records WHO did WHAT to
/// WHICH resource, and WHEN. Use `metadata` for free-form diff/details
/// (avoid storing secrets / PII verbatim).
model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String? // null if the actor is gone / a system process
  actorEmail   String? // denormalized so log survives user deletion
  action       String // e.g. "user.unlock", "lead.statusChange"
  resourceType String? // e.g. "User", "Lead", "Role"
  resourceId   String?
  metadata     Json? // diff / context (NEVER stores password)
  ipAddress    String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Media {
  id           String   @id @default(uuid())
  filename     String
  url          String
  cloudinaryId String?
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicleModelImages VehicleModelImage[]

  @@map("media")
}

model VehicleModelImage {
  id                  String   @id @default(uuid())
  assetCode           String   @unique
  fullAssetCode       String?
  assetName           String?
  normalizedAssetName String?
  imageUrl            String
  mediaId             String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([normalizedAssetName])
  @@index([isActive, updatedAt])
  @@map("vehicle_model_images")
}

// ============================================
// Dealer Sales Promotions (discount per model)
// ============================================

model DealerPromotion {
  id            String    @id @default(uuid())
  vendorCode    String
  vendorName    String?
  assetCode     String
  assetName     String?
  discountType  String // FIXED | PERCENT
  discountValue Float
  maxDiscount   Float?
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean   @default(true)
  notes         String?   @db.Text
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([vendorCode, assetCode])
  @@index([vendorCode, isActive])
  @@map("dealer_promotions")
}

// ============================================
// Credit Simulation Leads
// ============================================

model Lead {
  id                  String    @id @default(uuid())
  name                String
  phone               String
  email               String
  productName         String?
  productCode         String? // Kode produk kredit Hyundai (RF, BL, 50:50, dst.)
  firstInstallment    String? // ADDM | ADDB — skema cicilan pertama
  isPromotion         Boolean   @default(false) // true jika user pilih tab Promotion
  vehicleSummary      String? // Ringkasan kendaraan yang dipilih (model, trim, warna)
  assetSnapshot       Json? // Kode model/trim/warna untuk Hyundai AddLeadAsset
  /// Snapshot FinalSummaryInfo (Cust Consent) setelah user pilih tenor di ResultStep.
  summarySnapshot     Json?
  otrPrice            Float?
  discount            Float? // Potongan harga (nominal)
  partnerCode         String? // Kode partner Hyundai (opsional, dari PriceStep)
  dpPercent           Float?
  /// Override salesman vs rule Hyundai (`AdminFeeAmt`). Null = pakai nilai API.
  adminFeeAmtOverride Float?
  /// Override salesman vs rule Hyundai (`ProvisionFee` persen). Null = pakai nilai API.
  provisionFeeOverride Float?
  tenor               Int?
  notes               String?   @db.Text
  ktpUrl              String? // URL gambar KTP yang diupload
  ocrSnapshot         Json? // Hasil OCR KTP yang ditinjau/dikoreksi user di ContactModal
  citizenType         String? // LOCAL | FOREIGNER
  motherName          String? // Nama ibu kandung
  homeOwnershipStatus String? // Status kepemilikan rumah/bangunan
  consentAccepted     Boolean   @default(false) // Persetujuan pemrosesan data
  ipAddress           String? // IP user saat submit (dari request)
  latitude            Float? // Lokasi: latitude (dengan consent user)
  longitude           Float? // Lokasi: longitude (dengan consent user)
  slikStatus          String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, QUALIFIED, NOT_QUALIFIED, ERROR
  slikResultCode      String?
  slikResultDescr     String?
  slikRawResponse     Json?
  status              String    @default("NEW") // NEW, CONTACTED, QUALIFIED, CLOSED
  vendorCode          String?
  vendorName          String?
  vendorCity          String?
  oriOfficeCode       String?
  oriOfficeName       String?
  cmoEmpNo            String?
  cmoName             String?
  /// LeadNo Hyundai dari Step 4 (PriceStep) — disimpan saat user submit ContactModal,
  /// di-mirror dari `LeadAssetDraft.hyundaiLeadNo` yang dibuat ketika user submit harga.
  /// Berbeda dari `hyundaiLeadNo` di bawah, yang baru di-set saat admin submit lead
  /// (admin submit memicu AddLeadAsset baru → LeadNo baru lagi).
  simulationLeadNo    String?
  hyundaiLeadNo       String?
  hyundaiAssignStatus String    @default("PENDING") // PENDING, SUBMITTED, FAILED
  hyundaiAssignError  String?   @db.Text
  hyundaiAssignedAt   DateTime?
  /// WEBSITE | DEALER_SALES
  source              String    @default("WEBSITE")
  /// SupplierEmpNo yang terkirim ke Hyundai saat AddLeadAsset (pembanding data Adins)
  salesEmpNo          String?
  salesUserId         String?
  salesUser           User?     @relation("SalesLeads", fields: [salesUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ocrResults   LeadOcrResult[]
  hyundaiCalls HyundaiApiCallLog[]

  @@index([simulationLeadNo])
  @@index([source])
  @@index([salesUserId])
  @@map("leads")
}

model LeadOcrResult {
  id                 String   @id @default(uuid())
  leadId             String
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  hyundaiLeadNo      String?
  ktpFileName        String?
  status             String   @default("SUCCESS")
  errorMessage       String?  @db.Text
  rawResponse        Json?
  nik                String?
  nama               String?
  tempatLahir        String?
  tanggalLahir       String?
  jenisKelamin       String?
  alamat             String?
  kotaKabupaten      String?
  kecamatan          String?
  kelurahanDesa      String?
  zipCode            String?
  agama              String?
  statusPerkawinan   String?
  mrNationalityCode  String?
  addLeadCustPayload Json?
  createdAt          DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_ocr_results")
}

/// Generic audit log untuk request + response Hyundai API call yang krusial
/// (Save/Final/AddLeadCust). Tujuannya: troubleshooting lewat tim Hyundai
/// (compare payload yang kita kirim vs yang mereka terima/proses).
///
/// Tidak meng-cover SEMUA call—cuma yang dilist di `hyundai-api-log.ts:LoggedEndpoint`.
/// Whitelist supaya tabel tidak membengkak dengan call repetitive (Login, dropdown, dst).
model HyundaiApiCallLog {
  id             String   @id @default(uuid())
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  hyundaiLeadNo  String?
  endpoint       String // "SaveFinalCalculateResult" | "FinalCalculateByLeadNo" | "AddLeadCust"
  url            String
  status         String // "SUCCESS" | "FAILED"
  httpStatus     Int? // bisa null kalau request belum sampai/Hyundai unreachable
  hyundaiStatus  String? // dari envelope.StatusCode (bisa "200", "500", dll)
  hyundaiMessage String?  @db.Text
  requestBody    Json
  responseBody   Json?
  errorMessage   String?  @db.Text
  durationMs     Int?
  createdAt      DateTime @default(now())

  @@index([hyundaiLeadNo])
  @@index([leadId])
  @@index([endpoint])
  @@index([createdAt])
  @@map("hyundai_api_call_logs")
}

/// Preliminary Hyundai lead created at PriceStep submit (before customer contact data is filled).
/// Linked to a `Lead` record once user submits contact info via ResultStep — at that point,
/// `convertedLeadId` is set and `Lead.hyundaiLeadNo` mirrors `hyundaiLeadNo` here.
model LeadAssetDraft {
  id                String    @id @default(uuid())
  hyundaiLeadNo     String    @unique
  vendorCode        String?
  vendorName        String?
  oriOfficeCode     String?
  oriOfficeName     String?
  modelCode         String?
  modelName         String?
  fscCode           String?
  trimName          String?
  manufacturingYear Int?
  exteriorColorCode String?
  exteriorColorName String?
  interiorColorCode String?
  interiorColorName String?
  otrPrice          Float?
  discount          Float?
  partnerCode       String?
  assetPriceAmt     Float?
  /// SupplierEmpNo yang terkirim di AddLeadAsset (salesEmpNo salesman dealer)
  salesEmpNo        String?
  oemAccessoryCodes String[]  @default([])
  rawRequest        Json?
  rawResponse       Json?
  ipAddress         String?
  userAgent         String?   @db.Text
  status            String    @default("CREATED") // CREATED | CONVERTED | ABANDONED | FAILED
  convertedLeadId   String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([convertedLeadId])
  @@map("lead_asset_drafts")
}

/// Pre-simulated credit quotation for event/motorshow QR sharing.
/// Admin fills the full simulation wizard once; visitors open the public slug and see the summary.
model PreSimulation {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  isPublished Boolean @default(true)

  vendorCode    String?
  vendorName    String?
  vendorCity    String?
  oriOfficeCode String?
  oriOfficeName String?

  modelCode         String?
  modelName         String?
  manufacturingYear Int?
  fscCode           String?
  trimName          String?
  exteriorColorCode String?
  exteriorColorName String?
  interiorColorCode String?
  interiorColorName String?
  vehicleSummary    String?
  assetSnapshot     Json?

  otrPrice         Float?
  discount         Float?
  partnerCode      String?
  simulationLeadNo String?

  productCode      String?
  productName      String?
  dpPercent        Float?
  tenor            Int?
  firstInstallment String? // ADDM | ADDB
  isPromotion      Boolean @default(false)

  /// FinalSummaryInfo snapshot for public display (no live Hyundai call required).
  summarySnapshot Json?

  createdById String?
  createdBy   User?    @relation("PreSimulationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
  @@map("pre_simulations")
}
